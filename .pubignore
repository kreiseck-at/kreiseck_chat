# Spiegelt .gitignore — sobald diese Datei existiert, wertet pub die
# .gitignore beim Packen nicht mehr aus.
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/
*.iml
*.ipr
*.iws
.idea/
/pubspec.lock
**/doc/api/
.dart_tool/
.flutter-plugins-dependencies
/build/
/coverage/

# Interne Planungs- und Arbeitsdateien gehören nicht ins veröffentlichte Paket.
docs/
.superpowers/

# Plattform-Gerüst des Beispiels (Gradle, Xcode, CMake, App-Icons): 2 MB, die
# niemand braucht, der das Paket einbindet. pub.dev zeigt im Beispiel-Reiter
# nur example/lib; wer das Beispiel starten will, klont das Repo, wo alles
# unverändert liegt.
example/android/
example/ios/
example/macos/
example/linux/
example/windows/
